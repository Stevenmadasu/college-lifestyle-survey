{
  "navigationFallback": {
    "rewrite": "/index.html",
    "exclude": ["/assets/*", "/src/*"]
  },
  "routes": [
    {
      "route": "/assets/*",
      "headers": {
        "Cache-Control": "public, max-age=31536000, immutable"
      }
    }
  ],
  "responseOverrides": {
    "404": {
      "rewrite": "/index.html"
    }
  }
}
